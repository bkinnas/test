# Server
PORT=3001
NODE_ENV=development

# Data storage directory (invoices will be saved here)
DATA_DIR=./data

# ── Google Ads ──────────────────────────────────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── Meta (Facebook) Ads ─────────────────────────────────
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=

# ── Criteo ──────────────────────────────────────────────
CRITEO_CLIENT_ID=
CRITEO_CLIENT_SECRET=

# ── Amazon Ads ──────────────────────────────────────────
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=

# ── AppLovin ────────────────────────────────────────────
APPLOVIN_API_KEY=

# ── Email Invoice Fetching (IMAP) ──────────────────────
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_TLS=true

# ── Outlook Desktop Integration (Windows only) ────────
# Folder to search in local Outlook (default: Inbox)
OUTLOOK_FOLDER_PATH=Inbox

# ── Portal Scraping ────────────────────────────────────
# Set to "true" to run Puppeteer in headless mode
PUPPETEER_HEADLESS=true
# Path to Chrome/Chromium executable (for puppeteer-core)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
